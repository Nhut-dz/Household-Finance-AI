# Copy thành .env rồi điền. KHÔNG commit .env.

# Seed dùng chung cho toàn pipeline (sinh synthetic, split, train).
HFML_RANDOM_SEED=42

# Mức log: DEBUG | INFO | WARNING | ERROR. Bỏ trống → lấy từ config/config.yaml.
HFML_LOG_LEVEL=

# API key Gemini cho tầng LLM (F05 · M06). Lấy ở https://aistudio.google.com/apikey
# Bỏ trống → tầng llm chạy chế độ template tiếng Việt điền chỗ trống (PLAN.md §13).
GEMINI_API_KEY=

# Kết nối PostgreSQL Household_Finance_V2_Dev (pgAdmin 4). Host/port/name/user
# mặc định lấy từ config/config.yaml; chỉ đặt ở đây khi cần override.
# Server dev local trust auth → để trống HFML_DB_PASSWORD vẫn kết nối được.
HFML_DB_HOST=localhost
HFML_DB_PORT=5432
HFML_DB_NAME=HouseHold_Finance_V2_DEV
HFML_DB_USER=postgres
HFML_DB_PASSWORD=123456789
